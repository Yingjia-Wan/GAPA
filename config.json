{
  "model_name": "meta-llama/Meta-Llama-3-8B-Instruct",
  "task": "SFT_regression",
  "device_map": "auto",
  "device": "cuda",
  "trust_remote_code": false,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": ["q_proj", "v_proj"],
  "learning_rate": 0.0001,
  "lr_scheduler_type": "cosine",
  "warmup_ratio": 0.1,
  "num_train_epochs": 15,
  "eval_strategy": "steps",
  "eval_steps": 40,
  "save_steps": 40,
  "logging_steps": 5,
  "early_stopping_patience": 3,
  "weight_decay": 0.01,
  "head_init_scale": 0.02,
  "per_device_train_batch_size": 4,
  "per_device_eval_batch_size": 4,
  "max_length": 128,
  "val_size": 0.15,
  "test_size": 0.25,
  "random_seed": 42,
  "results_dir": "./results",
  "save_checkpoints": false,
  "wandb_project": "gender-training-models",
  "wandb_entity": null,
  "person_term_colors": {
    "woman": "#2196F3",
    "man": "#FF9800",
    "nonbinary": "#4CAF50",
    "mean": "#F44336"
  },
  "cross_validation": {
  "enabled": false,
  "k_folds": 5
  }
}

